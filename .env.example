# ─── Site ────────────────────────────────────────────────────────────────────
# Public URL, no trailing slash (SEO, sitemap, links inside emails)
NEXT_PUBLIC_SITE_URL=https://www.kerteranga.com

# ─── Supabase (Project Settings > API) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # public "anon" key — safe in the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # SECRET — server only, never prefix with NEXT_PUBLIC_

# ─── Email (Resend — https://resend.com) ─────────────────────────────────────
RESEND_API_KEY=re_...
# Sender on a domain verified in Resend (SPF/DKIM records added to your DNS)
EMAIL_FROM="Kër Téranga <reservations@kerteranga.com>"
# Inbox that receives booking / partnership / contact notifications
NOTIFY_EMAIL=kerterangasenegal@gmail.com   # private inbox that receives booking requests (never shown publicly)

# ─── Background email retries ────────────────────────────────────────────────
# Long random string (e.g. `openssl rand -hex 32`); protects /api/cron/emails
CRON_SECRET=change-me

# ─── Rate limiting (optional) ────────────────────────────────────────────────
# Salt used to anonymise visitor IPs before storing rate-limit counters
RATE_LIMIT_SALT=change-me-too
